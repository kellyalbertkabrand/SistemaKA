rules_version = '2';

// Regras de Segurança do Cloud Storage. Cole no Console do Firebase ->
// Storage -> aba Regras (Rules) -> Publicar.
//
// - Enviar arquivo (write): só o escritório logado.
// - Ler (read): liberado — os links (URLs com token) são usados no painel e,
//   quando a obra é pública, também podem aparecer para o cliente.

service firebase.storage {
  match /b/{bucket}/o {
    match /recibos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /fotos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
