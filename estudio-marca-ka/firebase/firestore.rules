rules_version = '2';

// ============================================================================
// Regras de segurança do Firestore — Sistema Visual de Publicações da Marca (KA)
//
// COMO USAR:
//   Firebase Console → Firestore Database → aba "Regras" (Rules) → cole tudo →
//   Publicar.
//
// Há DUAS versões abaixo. Deixe ATIVA apenas UMA (a outra fica comentada):
//
//   • MODO TESTE (padrão agora): tudo liberado — combina com o app em modo
//     aberto (sem login). Bom para testar rápido. ⚠️ Qualquer pessoa com o
//     endereço do projeto pode ler/gravar. Use só enquanto está testando.
//
//   • MODO PRODUÇÃO: leitura/gravação da gestão só para a KA logada
//     (kellyalbertka@gmail.com). As páginas públicas por token (orçamento e
//     contrato) continuam liberadas para leitura e para a resposta/assinatura.
//     Troque para esta versão antes de usar com clientes de verdade.
// ============================================================================

// ------------------------- MODO TESTE (ATIVO) -------------------------------
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

