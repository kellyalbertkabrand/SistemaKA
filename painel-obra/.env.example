# Copie este arquivo para ".env" e preencha com as suas chaves.
# (No Netlify, cadastre as mesmas variáveis em Site settings -> Environment variables.)

# --- Firebase (Console do Firebase -> Configurações do projeto -> Seus apps -> SDK) ---
# São chaves PÚBLICAS. Podem ficar no front com segurança, pois quem protege os
# dados são as Regras de Segurança do Firestore (firestore.rules).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Anthropic (console.anthropic.com -> API Keys) ---
# Esta chave é SECRETA e só é usada dentro da Netlify Function.
# Nunca use o prefixo VITE_ aqui, senão ela vazaria para o navegador.
ANTHROPIC_API_KEY=
