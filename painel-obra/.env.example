# Copie este arquivo para ".env" e preencha com as suas chaves.
# (No Netlify, cadastre as mesmas variáveis em Site settings -> Environment variables.)

# --- Supabase (Project Settings -> API) ---
# A URL do projeto e a chave pública "anon". Podem ficar no front com segurança,
# pois o Row Level Security (RLS) do banco é quem protege os dados.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Anthropic (console.anthropic.com -> API Keys) ---
# Esta chave é SECRETA e só é usada dentro da Netlify Function.
# Nunca use o prefixo VITE_ aqui, senão ela vazaria para o navegador.
ANTHROPIC_API_KEY=
