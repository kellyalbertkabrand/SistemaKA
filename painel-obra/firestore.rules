rules_version = '2';

// Regras de Segurança do Firestore. Cole no Console do Firebase ->
// Firestore Database -> Regras -> Publicar.
//
// Escritório único (piloto): exige apenas estar logado para o interno.
// Público (sem login): lê obra publicada + etapas/lançamentos/fotos dela, e
// envia cadastro com token de convite válido.

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function obraPublicada(obraId) {
      return exists(/databases/$(database)/documents/obras/$(obraId))
        && get(/databases/$(database)/documents/obras/$(obraId)).data.publicado == true;
    }

    match /obras/{id} {
      allow read: if resource.data.publicado == true || logado();
      allow write: if logado();
    }
    match /etapas/{id} {
      allow read: if logado() || obraPublicada(resource.data.obraId);
      allow write: if logado();
    }
    match /lancamentos/{id} {
      allow read: if logado() || obraPublicada(resource.data.obraId);
      allow write: if logado();
    }
    match /fotos/{id} {
      allow read: if logado() || obraPublicada(resource.data.obraId);
      allow write: if logado();
    }
    match /convites/{token} {
      allow read: if true;
      allow write: if logado();
    }
    match /clientes/{id} {
      allow read, update, delete: if logado();
      allow create: if logado()
        || (request.resource.data.token != null
            && exists(/databases/$(database)/documents/convites/$(request.resource.data.token)));
    }
    match /fornecedores/{id} {
      allow read, write: if logado();
    }
  }
}
